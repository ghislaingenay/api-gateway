# Local development environment (fake data — safe to commit).
#
# Copy this file to .env before running `docker compose up --build` or any
# `make serve SERVICE=...` / `go run ./cmd/...` command:
#
#   cp .env.example .env
#
# These values match docker-compose.yml's postgres/redis service creds and
# a dedicated JWT keypair generated only for this example file — none of
# it is a real secret.

APP_ENV='development'
PORT='8080'

# PostgreSQL (matches docker-compose.yml's `postgres` service)
DB_HOST='localhost'
DB_PORT='5433'
DB_DATABASE='gateway'
DB_USER='gateway'
DB_PASSWORD='gateway'
DB_SSL_MODE='disable'
DB_PG_CHANNELBINDING='disable'
DB_SCHEMA='public'

# Redis (matches docker-compose.yml's `redis` service)
REDIS_URL='redis://localhost:6380'

# Feature flags
# docker-compose.yml runs the dedicated `migrate` one-shot job instead, so
# the gateway itself doesn't migrate on boot.
ALLOW_AUTO_DB_MIGRATION='false'

# Gateway routing (config/routes.json's orders upstream uses
# "$env:ORDERS_SERVICE_UPSTREAM"). This value is for running the gateway
# directly on the host (e.g. `make serve SERVICE=api`) against the compose
# mock services; docker-compose.yml overrides this to
# "http://orders-service:8081" for the containerized gateway.
ORDERS_SERVICE_UPSTREAM='http://localhost:8081'

# Auth — dedicated local-only RSA keypair generated for this example file
# (openssl genrsa 2048 / openssl rsa -pubout), distinct from any real
# environment's signing key. Served by the mockjwks service.
JWT_ALLOWED_ALGORITHMS='RS256'
JWT_JWKS_URL='http://localhost:8083/.well-known/jwks.json'
JWT_JWKS_REFRESH_INTERVAL='1h'
JWT_SIGNING_KID='local-key'
JWT_SIGNING_PRIVATE_KEY=""

# CORS — allowlist of origins permitted to make credentialed requests.
# Empty is fine for local API-only testing; set this if you're also
# running a frontend dev server against this gateway.
CORS_ALLOWED_ORIGINS='http://localhost:3000'

# --- Everything below is optional: the code applies these same defaults
# --- when the variable is unset. Listed here for discoverability.

# Response cache
CACHE_DEFAULT_TTL_SECONDS='60'

# Rate limiting
RATE_LIMIT_PER_MINUTE_DEFAULT='60'
RATE_LIMIT_PER_HOUR_DEFAULT='1000'
RATE_LIMIT_LOGIN_PER_MINUTE_DEFAULT='20'

# Login brute-force protection
LOGIN_FAILURE_WINDOW_SECONDS='900'
LOGIN_FAILURE_DELAY_BASE_MS='250'
LOGIN_FAILURE_DELAY_MAX_MS='4000'
LOGIN_MAX_CONCURRENT_ATTEMPTS='50'

# Resilient proxying (retry + timeout)
GATEWAY_DEFAULT_TIMEOUT_SECONDS='5'
GATEWAY_RETRY_MAX_ATTEMPTS='3'
GATEWAY_RETRY_BASE_BACKOFF_MS='100'

# Refresh token cookie
COOKIE_SECURE='false'
COOKIE_SAMESITE='lax'
COOKIE_DOMAIN=''

# Client IP resolution (0 = trust only the raw TCP peer, ignore
# X-Forwarded-For)
TRUSTED_PROXY_HOPS='0'
